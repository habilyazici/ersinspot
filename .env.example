# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env dosyası asla depoya işlenmez.

NODE_ENV=development

# ---------------------------------------------------------------------------
# Veritabanı
# ---------------------------------------------------------------------------
# Yerel geliştirmede `pnpm db:up` ile ayağa kalkan Postgres'i işaret eder.
DATABASE_URL=postgresql://ersinspot:ersinspot_dev@localhost:5432/ersinspot

# ---------------------------------------------------------------------------
# Sunucu
# ---------------------------------------------------------------------------
API_PORT=3000
API_ORIGIN=http://localhost:3000

# Tarayıcı uygulamasının adresi. CORS izni ve çerez alanı buna göre belirlenir.
#
# İKİSİ AYNI SİTEDEN OLMALIDIR. Oturum çerezi `SameSite=Lax` yazılır; tarayıcı
# onu yalnızca aynı kayıtlı alan adına giden isteklerde gönderir. Şunlar olur:
#
#   ersinspot.com     + api.ersinspot.com   → çalışır (aynı site)
#   ersinspot.com.tr  + api-ersinspot.com   → ÇALIŞMAZ (ayrı siteler)
#
# İkinci durumda arıza sessizdir: giriş isteği 200 döner ve çerez yazılır ama
# sonraki hiçbir istekte gönderilmez, kullanıcı her sayfada oturumsuz görünür.
# Farklı alan adı zorunluysa çerez `SameSite=None; Secure` olmalıdır ve o
# durumda CSRF koruması yalnızca Origin denetimine kalır.
WEB_ORIGIN=http://localhost:3001

# Tarayıcı uygulamasının API'yi nerede arayacağı. BOŞ bırakılırsa istekler
# kendi kaynağına gider (`/api/...`) ve web sunucusunun onları API'ye
# vekillemesi gerekir — geliştirmede bunu Vite yapar.
#
# DERLEME ZAMANI değişkenidir: Vite değeri paketin içine gömer. Sunucunun
# ortamında tanımlamak hiçbir şeyi değiştirmez; `pnpm build` çalışırken
# tanımlı olmalıdır.
#
# Ayrı bir alan adı verilecekse WEB_ORIGIN ile aynı siteden olmalıdır
# (yukarıdaki nota bakın).
# VITE_API_URL=https://api.ersinspot.com

# ---------------------------------------------------------------------------
# Güvenlik
# ---------------------------------------------------------------------------
# Oturum çerezini imzalamak için kullanılır. En az 32 karakter olmalıdır.
# Üretimde rastgele üretin:  openssl rand -base64 48
SESSION_SECRET=

# Uygulama bir ters vekilin (nginx, Cloudflare, yük dengeleyici) arkasındaysa
# `true` yapın: istemci adresi vekilin yazdığı başlıktan okunur.
# Doğrudan internete açıksa `false` bırakın — aksi halde saldırgan başlığı
# uydurup hız sınırını atlar.
#
# Açarken vekilde adresi KENDİSİNİN yazdığından emin olun:
#   proxy_set_header X-Real-IP $remote_addr;
# X-Forwarded-For zinciri yaygın yapılandırmada istemcinin değerini ezmez,
# sonuna ekler; ilk halkası o zaman hâlâ istemcinin denetimindedir.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Dosya depolama
# ---------------------------------------------------------------------------
# Şimdilik yalnızca `local` uygulanmıştır. `s3` seçilirse süreç açılışta,
# anlaşılır bir mesajla durur — ilk dosya işleminde değil.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
STORAGE_PUBLIC_URL=http://localhost:3000/files

# STORAGE_DRIVER=s3 seçildiğinde gerekli:
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# E-posta (şifre sıfırlama ve bildirimler)
# ---------------------------------------------------------------------------
# Boş bırakılırsa e-postalar gönderilmez, konsola yazılır (geliştirme kolaylığı).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ersin Spot <bilgi@ersinspot.com>"
