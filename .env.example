# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env dosyası asla depoya işlenmez.

NODE_ENV=development

# ---------------------------------------------------------------------------
# Veritabanı
# ---------------------------------------------------------------------------
# Yerel geliştirmede `pnpm db:up` ile ayağa kalkan Postgres'i işaret eder.
DATABASE_URL=postgresql://ersinspot:ersinspot_dev@localhost:5432/ersinspot

# ---------------------------------------------------------------------------
# Sunucu
# ---------------------------------------------------------------------------
API_PORT=3000
API_ORIGIN=http://localhost:3000

# Tarayıcı uygulamasının adresi. CORS izni ve çerez alanı buna göre belirlenir.
WEB_ORIGIN=http://localhost:3001

# ---------------------------------------------------------------------------
# Güvenlik
# ---------------------------------------------------------------------------
# Oturum çerezini imzalamak için kullanılır. En az 32 karakter olmalıdır.
# Üretimde rastgele üretin:  openssl rand -base64 48
SESSION_SECRET=

# Uygulama bir ters vekilin (nginx, Cloudflare, yük dengeleyici) arkasındaysa
# `true` yapın: istemci adresi X-Forwarded-For başlığından okunur.
# Doğrudan internete açıksa `false` bırakın — aksi halde saldırgan başlığı
# uydurup hız sınırını atlar.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Dosya depolama
# ---------------------------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
STORAGE_PUBLIC_URL=http://localhost:3000/files

# STORAGE_DRIVER=s3 seçildiğinde gerekli:
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# E-posta (şifre sıfırlama ve bildirimler)
# ---------------------------------------------------------------------------
# Boş bırakılırsa e-postalar gönderilmez, konsola yazılır (geliştirme kolaylığı).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Ersin Spot <bilgi@ersinspot.com>"
