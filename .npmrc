# Hayalet bağımlılıkları engelle: bir paket, package.json'ında yazmadığı bir modülü
# import edemesin. Eski kod tabanındaki en sinsi kırılma sınıflarından biri buydu.
strict-peer-dependencies=false
auto-install-peers=true

# Derleme betiği çalıştırmasına izin verilen paketler açıkça onaylanır.
enable-pre-post-scripts=true
